# Backblaze B2 (required) — S3-compatible API
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# Region slug of your bucket's endpoint. The S3 endpoint is derived as
# https://s3.<B2_REGION>.backblazeb2.com — read it off your bucket's Endpoint
# in the B2 console (e.g. an endpoint of s3.us-west-004.backblazeb2.com → us-west-004).
B2_REGION=your_region

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=your-25-char-key-id
# B2_APPLICATION_KEY=your-application-key-shown-once
# B2_BUCKET_NAME=my-audio-archive
# B2_REGION=us-west-004

# Optional. Public base URL for the bucket (only used to build public object
# URLs when the bucket is public). Leave unset for a private bucket — the app
# serves audio through short-lived presigned URLs regardless.
# B2_PUBLIC_URL_BASE=https://my-audio-archive.s3.us-west-004.backblazeb2.com

# Optional. Compute device for the local AudioSR model. Unset = auto-detect
# (CUDA if available, else CPU). MPS is skipped by default because AudioSR's
# latent-diffusion + torchlibrosa stack has known-unsupported ops on Apple MPS;
# opt in explicitly with AUDIOSR_DEVICE=mps if you want to try it.
# AUDIOSR_DEVICE=cpu

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
